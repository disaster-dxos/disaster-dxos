# SPDX-License-Identifier: Apache-2.0
# Cấu hình Disaster DX-OS. Sao chép: cp .env.example .env rồi ĐỔI mọi giá trị "doi-..."
# Đây là giá trị mẫu cho máy dev, KHÔNG phải mật khẩu thật. Không commit file .env.

COMPOSE_PROJECT_NAME=disaster-dxos
# Ứng dụng Tầng 2 cắm vào lõi: thư mục apps/<DXOS_APP>/ (realm Keycloak, schema, workflow, seed)
DXOS_APP=cuu-tro

# ---------- PostgreSQL + PostGIS (profile core) ----------
# Image postgis/postgis chỉ có bản amd64; trên Mac Apple Silicon chạy qua giả lập.
POSTGIS_PLATFORM=linux/amd64
POSTGRES_USER=dxos
POSTGRES_PASSWORD=doi-mat-khau-postgres
POSTGRES_DB=disaster
POSTGRES_PORT=15432
# CSDL riêng cho Keycloak (tạo bởi core/postgres/init)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=doi-mat-khau-keycloak-db

# ---------- Keycloak (profile core) ----------
KEYCLOAK_PORT=8080
# URL công khai của Keycloak: giá trị "iss" trong token. Phải là URL trình duyệt/client truy cập được.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=doi-mat-khau-admin
KEYCLOAK_REALM=disaster
# Secret của client "dxos-gateway" (APISIX dùng). Đổi bằng: openssl rand -hex 24
KC_GATEWAY_CLIENT_SECRET=doi-secret-gateway
# Mật khẩu 3 người dùng mẫu (dieuphoi01, cuuho01, tinhnguyen01) — chỉ dùng khi dev
KC_DEMO_USER_PASSWORD=doi-mat-khau-demo
# Realm đòi HTTPS khi nào: external (mặc định – IP riêng/localhost được dùng HTTP), all, none.
# Nếu lấy token từ máy host bị lỗi "HTTPS required" (VPN/proxy làm Keycloak thấy IP công khai),
# đặt none CHỈ trên máy dev rồi chạy lại: docker compose down -v && make up
KC_REALM_SSL_REQUIRED=external

# ---------- APISIX (profile core) ----------
APISIX_PORT=9080

# ---------- Dịch vụ tuần 2 (profile core-next) ----------
HASURA_PORT=8081
HASURA_GRAPHQL_ADMIN_SECRET=doi-secret-hasura
SEAWEEDFS_S3_PORT=8333
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8088
NATS_PORT=4222
NATS_MQTT_PORT=1883
OPENBAO_PORT=8200
OPENBAO_DEV_ROOT_TOKEN=doi-token-openbao
