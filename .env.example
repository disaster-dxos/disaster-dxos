# SPDX-License-Identifier: Apache-2.0
# Cấu hình Disaster DX-OS. Sao chép: cp .env.example .env rồi ĐỔI mọi giá trị "doi-..."
# Đây là giá trị mẫu cho máy dev, KHÔNG phải mật khẩu thật. Không commit file .env.
#
# Bí mật của dịch vụ lõi nằm trong OpenBao (#14, #11), KHÔNG đặt ở đây. `make up`
# (scripts/openbao-init.sh) tự sinh ngẫu nhiên lần đầu:
#   secret/core/postgres        password        superuser PostgreSQL (trước đây POSTGRES_PASSWORD)
#   secret/core/keycloak-db     password        (trước đây KEYCLOAK_DB_PASSWORD)
#   secret/core/keycloak-admin  password        (trước đây KC_BOOTSTRAP_ADMIN_PASSWORD)
#   secret/core/gateway         client_secret   (trước đây KC_GATEWAY_CLIENT_SECRET)
#   secret/core/hasura-db       password        role hasura
#   secret/core/hasura          admin_secret    (trước đây HASURA_GRAPHQL_ADMIN_SECRET)
#   secret/core/temporal-db     password        role temporal
#   secret/core/s3              access_key, secret_key   SeaweedFS S3
#   secret/core/ledger          signing_key, verifier_key   khóa ký checkpoint Ed25519 của sổ cái (#28),
#                               sinh MỘT lần; khóa công khai cũng xem được ở http://localhost:9080/ledger/verifier
#   secret/app/<DXOS_APP>/ledger write_token   token để backend ứng dụng ghi sổ cái (chỉ mạng nội bộ, #28)
#   secret/app/<DXOS_APP>/db    password        role dịch vụ <schema>_app của ứng dụng (cuu_tro_app, #29)
# Nâng cấp từ bản cũ có volume pgdata: giữ các biến cũ ở trên trong .env cho lần `make up` đầu,
# script nạp đúng giá trị đó vào OpenBao (khớp dữ liệu cũ); sau đó xóa chúng khỏi .env.
# Xem/đổi: BAO_TOKEN=$(cat .data/openbao/root.token) docker compose exec -e BAO_TOKEN openbao bao kv get secret/core/gateway

COMPOSE_PROJECT_NAME=disaster-dxos
# Ứng dụng Tầng 2 cắm vào lõi: thư mục apps/<DXOS_APP>/ (realm Keycloak, schema, workflow, seed)
DXOS_APP=cuu-tro

# ---------- PostgreSQL + PostGIS (profile core) ----------
# Image postgis/postgis chỉ có bản amd64; trên Mac Apple Silicon chạy qua giả lập.
POSTGIS_PLATFORM=linux/amd64
POSTGRES_USER=dxos
# Mật khẩu superuser: OpenBao secret/core/postgres. Chỉ dùng cho initdb lần đầu và postgres-roles;
# không dịch vụ nào kết nối bằng superuser (core/postgres/sync-roles.sh)
POSTGRES_DB=disaster
POSTGRES_PORT=15432
# CSDL riêng cho Keycloak (tạo bởi core/postgres/init). Mật khẩu: OpenBao secret/core/keycloak-db
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
# Role riêng của Hasura và Temporal (postgres-roles tạo). Mật khẩu: secret/core/hasura-db, temporal-db
HASURA_DB_USER=hasura
TEMPORAL_DB_USER=temporal

# ---------- Keycloak (profile core) ----------
KEYCLOAK_PORT=8080
# URL công khai của Keycloak: giá trị "iss" trong token. Phải là URL trình duyệt/client truy cập được.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Mật khẩu admin: OpenBao secret/core/keycloak-admin (chỉ dùng khi Keycloak tạo CSDL lần đầu)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_REALM=disaster
# Secret của client "dxos-gateway" (APISIX + Keycloak dùng): OpenBao secret/core/gateway
# Mật khẩu 3 người dùng mẫu (dieuphoi01, cuuho01, tinhnguyen01) — dữ liệu giả của apps/cuu-tro,
# chỉ dùng khi dev và cho scripts/smoke-jwt.sh; không phải bí mật của dịch vụ lõi
KC_DEMO_USER_PASSWORD=doi-mat-khau-demo
# Realm đòi HTTPS khi nào: external (mặc định – IP riêng/localhost được dùng HTTP), all, none.
# Nếu lấy token từ máy host bị lỗi "HTTPS required" (VPN/proxy hoặc mạng của Docker Desktop làm
# Keycloak thấy IP công khai), đặt none CHỈ trên máy dev. Realm chỉ import lần đầu nên phải tạo lại
# CSDL (giữ OpenBao): make down && docker volume rm <COMPOSE_PROJECT_NAME>_pgdata && make up
KC_REALM_SSL_REQUIRED=external

# ---------- APISIX (profile core) ----------
# Route /graphql, /files/*, /workflow/*: docs/architecture.md mục 3.2 (#12)
APISIX_PORT=9080
# Origin web Tầng 2 được gọi API từ trình duyệt (CORS), cách nhau bởi dấu phẩy, không dùng "*".
# Web chạy trong compose mở qua chính gateway (route /*, #64) nên cùng origin, không cần CORS;
# localhost:3000 dành cho `npm run dev`
GW_CORS_ALLOW_ORIGINS=http://localhost:3000
# Rate limit mỗi IP trên mỗi route API: GW_RATE_LIMIT_COUNT request trong GW_RATE_LIMIT_WINDOW giây (vượt → 429)
GW_RATE_LIMIT_COUNT=300
GW_RATE_LIMIT_WINDOW=60
# Kích thước tối đa một request /files (byte, mặc định 20 MiB, vượt → 413). /files chỉ đọc (GET/HEAD, #27)
GW_FILES_MAX_BODY_BYTES=20971520
# Kích thước tối đa một request tải tệp lên /workflow/tai-len/* (byte, mặc định 20 MiB, vượt → 413).
# API của ứng dụng còn giới hạn riêng nhỏ hơn (ANH_MAX_BYTES)
GW_UPLOAD_MAX_BODY_BYTES=20971520
# Route /* → web Tầng 2 (#64), chỉ GET/HEAD: giới hạn riêng vì một lần mở trang tải 10-20 tệp
GW_WEB_RATE_LIMIT_COUNT=600
# Route WebSocket /realtime/websocket → Centrifugo (#68) và /graphql (subscription, #60): số lần mở
# WebSocket mỗi IP trong GW_RATE_LIMIT_WINDOW giây (mỗi route đếm riêng)
GW_REALTIME_RATE_LIMIT_COUNT=60
# Route POST /workflow/keu-cuu (#66): giới hạn riêng, chặt hơn route API chung, chống spam tin kêu cứu
# (số request mỗi IP trong GW_RATE_LIMIT_WINDOW giây, vượt → 429; route này đếm riêng)
GW_KEU_CUU_RATE_LIMIT_COUNT=20

# ---------- OpenBao (profile core) — chỉ thông tin để khởi động/mở khóa ----------
OPENBAO_PORT=8200
# Nơi scripts/openbao-init.sh ghi unseal key, root token, role_id/secret_id. PHẢI nằm ngoài git
# (.data/ đã có trong .gitignore). Mất thư mục này = mất khả năng mở khóa dữ liệu trong volume baodata.
OPENBAO_LOCAL_DIR=./.data/openbao
# Shamir: số mảnh key và số mảnh cần để mở khóa (chỉ áp dụng ở lần init đầu)
OPENBAO_KEY_SHARES=3
OPENBAO_KEY_THRESHOLD=2
# CHỈ DÙNG CHO DEV: container openbao-unseal tự mở khóa sau khi khởi động lại bằng key trong
# OPENBAO_LOCAL_DIR. Trên VPS đặt false và mở khóa thủ công: make bao-unseal
OPENBAO_DEV_AUTO_UNSEAL=true

# ---------- Hasura, SeaweedFS, Temporal, NATS (profile core, #11) ----------
# Các cổng dưới chỉ mở trên 127.0.0.1 (quản trị, smoke test). Tầng 2 đi qua APISIX (#12).
# Admin secret Hasura: OpenBao secret/core/hasura
HASURA_PORT=8081
# Khóa S3: OpenBao secret/core/s3 (quản trị); khóa của ứng dụng: secret/app/<DXOS_APP>/s3 (chỉ bucket <DXOS_APP>-*)
SEAWEEDFS_S3_PORT=8333
# Cỡ mỗi volume SeaweedFS (MB); nhỏ để tiết kiệm ổ trên laptop
SEAWEEDFS_VOLUME_SIZE_MB=256
TEMPORAL_PORT=7233
# Temporal UI: chỉ cho quản trị viên, chỉ trên 127.0.0.1
TEMPORAL_UI_PORT=8088
# NATS: bắt buộc xác thực (#30). Mật khẩu <DXOS_APP>-app / <DXOS_APP>-thiet-bi: OpenBao secret/app/<DXOS_APP>/nats
NATS_PORT=4222
NATS_MQTT_PORT=1883
# Địa chỉ công bố cổng MQTT trên máy host: 127.0.0.1 (giả lập trên máy) hoặc 0.0.0.0 (thiết bị trong LAN; chưa TLS)
NATS_MQTT_BIND=127.0.0.1
# Giới hạn JetStream toàn server (laptop)
NATS_JS_MAX_MEMORY=64MB
NATS_JS_MAX_FILE=1GB

# ---------- Sổ cái minh bạch core/ledger (profile core, Tessera, #28) ----------
# Tên sổ cái (origin) ghi trong mọi checkpoint và là tên khóa ký. Chỉ dùng khi scripts/openbao-init.sh
# sinh khóa lần đầu; đổi sau đó không có tác dụng (phải sinh khóa mới, công bố khóa công khai mới).
# Dạng URL không có scheme, không khoảng trắng, không dấu +.
LEDGER_ORIGIN=localhost/disaster-dxos/ledger
# Checkpoint ký lại tối đa mỗi khoảng này khi có lá mới (lá mới có proof sau chừng ấy thời gian)
LEDGER_CHECKPOINT_INTERVAL=1s
# Giới hạn heap Go của ledger (BadgerDB chống trùng); mem_limit container 256 MB
LEDGER_GOMEMLIMIT=150MiB
# Khóa công khai cuu-tro-api dùng kiểm chữ ký checkpoint. Trống = lấy một lần từ ledger nội bộ.
# Triển khai thật: ghim giá trị đã công bố (http://<gateway>/ledger/verifier) để phát hiện khóa bị thay.
LEDGER_VERIFIER_KEY=
# Centrifugo OSS (#68): origin được mở WebSocket (cách nhau bởi dấu cách). Trống = GATEWAY_PUBLIC_URL.
# Khóa ký token kết nối và API key nằm trong OpenBao (secret/app/<DXOS_APP>/realtime), không ở đây.
# CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:9080 http://localhost:3000
# Scorpio NGSI-LD (#85): CSDL riêng trên PostgreSQL của lõi (postgres-roles tạo, mật khẩu trong OpenBao
# secret/core/scorpio-db). Image chỉ có amd64: Mac Apple Silicon chạy giả lập (như POSTGIS_PLATFORM).
# SCORPIO_DB=scorpio
# SCORPIO_DB_USER=scorpio
# SCORPIO_PLATFORM=linux/amd64
# Số kết nối PostgreSQL tối đa của pool Scorpio (role scorpio có CONNECTION LIMIT 20)
# SCORPIO_DB_POOL=8
# Route /ngsi-ld/v1/* của APISIX đặt header Link tới @context của ứng dụng. Trống = quy ước
# http://<DXOS_APP>-api:8000/ngsi-ld/context.jsonld (chỉ trong mạng nội bộ)
# GW_NGSI_LD_CONTEXT_URL=http://cuu-tro-api:8000/ngsi-ld/context.jsonld

# ---------- Backend ứng dụng apps/cuu-tro (profile app, #29) ----------
# Route /workflow/* của APISIX trỏ vào API workflow của ứng dụng. Để trống = quy ước <DXOS_APP>-api:8000
# GW_WORKFLOW_UPSTREAM_HOST=cuu-tro-api
# GW_WORKFLOW_UPSTREAM_PORT=8000
# Task queue Temporal của worker cuu-tro (namespace "default" do temporalio/auto-setup tạo)
CUU_TRO_TASK_QUEUE=cuu-tro
# Workflow PhanCongCuuHo: bán kính tìm đội (m), hạn chờ xác nhận "đã cứu" (giây),
# số lần tìm đội khi chưa có đội sẵn sàng và thời gian chờ giữa hai lần (giây)
PHAN_CONG_BAN_KINH_M=20000
PHAN_CONG_HAN_XAC_NHAN_GIAY=21600
# Cảnh báo vượt ngưỡng (#87): kênh thông báo ra ngoài của workflow CanhBaoVuotNguong.
#   gia-lap  (mặc định) chỉ hộp thư nội bộ (bảng sensor_alert_notifications, /graphql) + web điều phối
#   telegram thêm Telegram Bot API; token + chat id nằm trong OpenBao secret/app/cuu-tro/telegram (KHÔNG ở đây)
CANH_BAO_KENH=gia-lap
# Đợt không có sự kiện về dưới ngưỡng thì workflow tự kết thúc sau ngần này giây (mặc định 7 ngày)
# CANH_BAO_HAN_DOT_GIAY=604800
# TELEGRAM_API_URL=https://api.telegram.org
# Grafana (#92, profile bi) và bộ xuất Parquet (#91) đọc CSDL bằng role chỉ đọc <schema>_bi; mật khẩu trong
# OpenBao secret/app/<DXOS_APP>/bi-db, admin Grafana trong secret/core/grafana. DXOS_APP khác cuu-tro thì đặt:
# APP_BI_DB_USER=cuu_tro_bi
# Sổ cái minh bạch (#89): worker quét mỗi SO_CAI_QUET_GIAY giây các phiếu kho / bút toán tiền chưa niêm phong
# cũ hơn SO_CAI_CHO_GIAY giây (API niêm phong ngay khi lập; worker ghi bù khi sổ cái tạm dừng)
# SO_CAI_QUET_GIAY=10
# SO_CAI_CHO_GIAY=5
PHAN_CONG_SO_LAN_TIM_DOI=10
PHAN_CONG_CHO_TIM_LAI_GIAY=60
# Phân công tự động (#67): tin mới tự khởi chạy PhanCongCuuHo (0 = tắt, chỉ khởi chạy tay qua API);
# chu kỳ quét outbox phòng lỡ NOTIFY (giây). Hạn để đội nhận nhiệm vụ theo urgency (giây): quá hạn
# hoặc đội từ chối thì gỡ đội, giao đội gần nhất kế tiếp; tối đa PHAN_CONG_SO_LAN_GIAO_TOI_DA lần giao
# rồi báo điều phối (NATS cuu-tro.dieu-phoi.can-xu-ly.<id_tin>)
PHAN_CONG_TU_DONG=1
PHAN_CONG_QUET_GIAY=30
PHAN_CONG_HAN_NHAN_GIAY_KHAN_CAP=300
PHAN_CONG_HAN_NHAN_GIAY_CAO=600
PHAN_CONG_HAN_NHAN_GIAY_TRUNG_BINH=900
PHAN_CONG_HAN_NHAN_GIAY_THAP=1800
PHAN_CONG_SO_LAN_GIAO_TOI_DA=3
# Ảnh hiện trường (#27): kích thước tối đa một ảnh (byte, mặc định 10 MiB, vượt → 413), hạn link xem
# presigned mặc định và tối đa (giây). URL công khai của gateway mà link xem trỏ tới (/files/*)
ANH_MAX_BYTES=10485760
ANH_LINK_HAN_GIAY=300
GATEWAY_PUBLIC_URL=http://localhost:9080
# Thông báo realtime (#68): hạn token kết nối Centrifugo do cuu-tro-api cấp (giây, 30-3600); web tự
# xin token mới trước khi hết hạn, mất vai trò điều phối thì không xin được nữa
REALTIME_TOKEN_HAN_GIAY=300
# Tiếp nhận tin kêu cứu POST /workflow/keu-cuu (#66): vùng phục vụ, tọa độ ngoài vùng → 422.
# Dạng kinh_do_min,vi_do_min,kinh_do_max,vi_do_max (WGS 84); trống = Việt Nam kể cả Hoàng Sa, Trường Sa
# (102.1,6.0,117.9,23.4). Bán kính/khoảng thời gian chặn trùng nằm trong CSDL: bảng cuu_tro.incident_dedup_config
KEU_CUU_VUNG_PHUC_VU=

# ---------- Web điều phối apps/cuu-tro/web (Nuxt, #59, #64) ----------
# Web là client OIDC công khai (PKCE), KHÔNG có bí mật nào. make up chạy dịch vụ cuu-tro-web (profile
# app), mở qua gateway tại GATEWAY_PUBLIC_URL (http://localhost:9080/); compose tự đặt các biến dưới
# từ KEYCLOAK_PUBLIC_URL, KEYCLOAK_REALM, GATEWAY_PUBLIC_URL. Client dxos-web nhận redirect_uri
# ${GATEWAY_PUBLIC_URL}/* (Keycloak đọc lúc import realm lần đầu). Chỉ cần đặt tay khi chạy web ngoài
# compose (`npm run dev`); mặc định trong nuxt.config.ts.
# NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# NUXT_PUBLIC_KEYCLOAK_REALM=disaster
# NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=dxos-web
# NUXT_PUBLIC_GATEWAY_URL=http://localhost:9080
# NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Kiểu nền bản đồ khi giao diện ở chế độ tối (#77)
# NUXT_PUBLIC_MAP_STYLE_URL_TOI=https://tiles.openfreemap.org/styles/dark
