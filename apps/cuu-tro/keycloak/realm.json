{
  "realm": "disaster",
  "displayName": "Disaster DX-OS",
  "enabled": true,
  "sslRequired": "${KC_REALM_SSL_REQUIRED}",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "dieu-phoi",
        "description": "Cán bộ xã điều phối cứu trợ"
      },
      {
        "name": "cuu-ho",
        "description": "Thành viên đội cứu hộ"
      },
      {
        "name": "tinh-nguyen",
        "description": "Tình nguyện viên"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dxos-gateway",
      "name": "APISIX API Gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_GATEWAY_CLIENT_SECRET}",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "dxos-web",
      "name": "Web điều phối (Nuxt)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "${GATEWAY_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "${GATEWAY_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##${GATEWAY_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "hasura-allowed-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-allowed-roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "hasura-default-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-default-role",
            "user.attribute": "hasura_default_role",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "hasura-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-user-id",
            "user.attribute": "id",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "dxos-dev-cli",
      "name": "CHỈ DÙNG KHI DEV: lấy token bằng mật khẩu để thử API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "hasura-allowed-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-allowed-roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "hasura-default-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-default-role",
            "user.attribute": "hasura_default_role",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "hasura-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "https://hasura\\.io/jwt/claims.x-hasura-user-id",
            "user.attribute": "id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "9b000000-0000-4000-8000-000000000001",
      "username": "dieuphoi01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Điều phối",
      "lastName": "Mẫu",
      "email": "dieuphoi01@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-disaster",
        "dieu-phoi"
      ],
      "attributes": {
        "hasura_default_role": [
          "dieu-phoi"
        ]
      }
    },
    {
      "id": "9b000000-0000-4000-8000-000000000002",
      "username": "cuuho01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Cứu hộ",
      "lastName": "Mẫu",
      "email": "cuuho01@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-disaster",
        "cuu-ho"
      ],
      "attributes": {
        "hasura_default_role": [
          "cuu-ho"
        ]
      }
    },
    {
      "id": "9b000000-0000-4000-8000-000000000003",
      "username": "tinhnguyen01",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tình nguyện",
      "lastName": "Mẫu",
      "email": "tinhnguyen01@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-disaster",
        "tinh-nguyen"
      ],
      "attributes": {
        "hasura_default_role": [
          "tinh-nguyen"
        ]
      }
    }
  ],
  "browserFlow": "browser-otp-dieu-phoi",
  "authenticatorConfig": [
    {
      "alias": "cond-role-dieu-phoi",
      "config": {
        "condUserRole": "dieu-phoi",
        "negate": "false"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-otp-dieu-phoi",
      "description": "Trình duyệt: cookie hoặc mật khẩu; vai trò dieu-phoi bắt buộc OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-otp-dieu-phoi forms"
        }
      ]
    },
    {
      "alias": "browser-otp-dieu-phoi forms",
      "description": "Mật khẩu rồi OTP có điều kiện",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "browser-otp-dieu-phoi otp"
        }
      ]
    },
    {
      "alias": "browser-otp-dieu-phoi otp",
      "description": "OTP khi user có vai trò dieu-phoi; chưa cài thì bị bắt cài (CONFIGURE_TOTP)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "authenticatorConfig": "cond-role-dieu-phoi"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"hasura_default_role\",\"displayName\":\"Vai trò mặc định (Hasura)\",\"validations\":{\"options\":{\"options\":[\"dieu-phoi\",\"cuu-ho\",\"tinh-nguyen\"]}},\"annotations\":{\"inputType\":\"select\"},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
