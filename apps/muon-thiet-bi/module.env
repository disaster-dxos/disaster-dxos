# Biến cần đặt (thêm vào .env, hoặc export) khi chạy lõi với module này (docs/viet-module.md mục 4).
DXOS_APP=muon-thiet-bi
# Realm trong keycloak/realm.json
KEYCLOAK_REALM=thiet-bi
# Smoke lõi dùng chung (scripts/smoke-core.sh) đăng nhập bằng user mẫu của module: "<user>:<vai mặc định>"
SMOKE_CORE_USERS="quanly01:quan-ly nguoimuon01:nguoi-muon"
# Profile bi (Grafana) đọc CSDL bằng role chỉ đọc <schema>_bi của module
APP_BI_DB_USER=muon_thiet_bi_bi
